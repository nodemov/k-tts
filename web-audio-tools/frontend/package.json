{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:wasm": "cd ../dsp-wasm && cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/dsp_wasm.wasm ../frontend/src/lib/dsp/dsp.wasm",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@ffmpeg/core": "^0.12.10",
		"@ffmpeg/ffmpeg": "^0.12.15",
		"@ffmpeg/util": "^0.12.2",
		"@fontsource/anuphan": "^5.3.0",
		"@fontsource/chakra-petch": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"fflate": "^0.8.3",
		"wavesurfer.js": "^8.0.3"
	}
}
