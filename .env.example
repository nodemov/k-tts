# PostgreSQL connection for novels DB (used by cmd/fetch-chapters)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/novels_2026

# One API key per 9router VM. Create the key on that VM, then replace replace-me.
# Workers left as replace-me are skipped.
ROUTER_VM_1_URL=https://9router-vm-1.devbucket.space
ROUTER_VM_1_API_KEY=replace-me
